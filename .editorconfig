root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Almost everything here is embedded in the live Worker byte for byte (only src/fonts/OFL.txt and
# src/chess/engine/README.md are not): an editor must not add or remove anything.
[src/**]
insert_final_newline = unset
trim_trailing_whitespace = unset

[src/chess/engine/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset

# Licence texts stay exactly as published upstream.
[{LICENSE,**/OFL.txt}]
insert_final_newline = unset
trim_trailing_whitespace = unset
